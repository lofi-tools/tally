{
  "source": "JFCVC v4.0 (2020-06-09) + HMRC iXBRL style guide v2.2, extracted from Arelle's validate/UK plugin (arelle/plugin/validate/UK/__init__.py and ValidateUK.py). Concept local names only (namespace prefixes are resolved by the checker).",
  "taxonomyTypes": {
    "ukGAAP": {
      "mandatory": [
        "AverageNumberEmployeesDuringPeriod", "EntityCurrentLegalOrRegisteredName",
        "StartDateForPeriodCoveredByReport", "EndDateForPeriodCoveredByReport",
        "BalanceSheetDate", "DateApprovalAccounts", "NameDirectorSigningAccounts",
        "EntityDormant", "EntityTrading", "DateSigningDirectorsReport", "DirectorSigningReport"
      ]
    },
    "charities": {
      "mandatory": [
        "AverageNumberEmployeesDuringPeriod", "EntityCurrentLegalOrRegisteredName",
        "StartDateForPeriodCoveredByReport", "EndDateForPeriodCoveredByReport",
        "BalanceSheetDate", "DateAuthorisationFinancialStatementsForIssue",
        "DirectorSigningFinancialStatements", "EntityDormantTruefalse", "EntityTradingStatus",
        "AccountingStandardsApplied", "AccountsStatusAuditedOrUnaudited"
      ],
      "mustHaveOne": [
        "CharityRegistrationNumberEnglandWales", "CharityRegistrationNumberScotland",
        "CharityRegistrationNumberNorthernIreland"
      ]
    },
    "ukIFRS": {
      "mandatory": [
        "AverageNumberEmployeesDuringPeriod", "EntityCurrentLegalOrRegisteredName",
        "StartDateForPeriodCoveredByReport", "EndDateForPeriodCoveredByReport",
        "BalanceSheetDate", "DateAuthorisationFinancialStatementsForIssue",
        "ExplanationOfBodyOfAuthorisation", "EntityDormant", "EntityTrading",
        "DateSigningDirectorsReport", "DirectorSigningReport"
      ]
    },
    "FRS": {
      "mandatory": [
        "AverageNumberEmployeesDuringPeriod", "EntityCurrentLegalOrRegisteredName",
        "StartDateForPeriodCoveredByReport", "EndDateForPeriodCoveredByReport",
        "BalanceSheetDate", "DateAuthorisationFinancialStatementsForIssue",
        "DirectorSigningFinancialStatements", "EntityDormantTruefalse", "EntityTradingStatus",
        "AccountingStandardsApplied", "AccountsStatusAuditedOrUnaudited",
        "LegalFormEntity", "DescriptionPrincipalActivities", "AccountsTypeFullOrAbbreviated"
      ]
    },
    "FRS-2022": {
      "mandatory": [
        "AverageNumberEmployeesDuringPeriod", "EntityCurrentLegalOrRegisteredName",
        "StartDateForPeriodCoveredByReport", "EndDateForPeriodCoveredByReport",
        "BalanceSheetDate", "DateAuthorisationFinancialStatementsForIssue",
        "DirectorSigningFinancialStatements", "EntityDormantTruefalse", "EntityTradingStatus",
        "AccountingStandardsApplied", "AccountsStatusAuditedOrUnaudited",
        "LegalFormEntity", "DescriptionPrincipalActivities", "AccountsType"
      ]
    },
    "ct-comp": {
      "_note": "The HMRC computation taxonomy (ct-comp) is validated by the ct-comp schema and HMRC's CT600 spec, not by the JFCVC accounts rule set. Arelle's plugin misclassifies ct-comp documents as accounts (its 2020 namespace regex predates the hmrc.gov.uk ct-comp namespace) and wrongly demands the FRS-2022 mandatory set; this checker instead recognises ct-comp and skips the accounts mandatory-items rule.",
      "mandatory": []
    }
  },

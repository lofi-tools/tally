    "OtherPost-employmentBenefitPlan": { "min": 1, "max": 2, "facts": ["NameDefinedContributionPlan", "NameDefinedBenefitPlan"] },
    "OtherContractType": { "min": 1, "max": 2, "facts": ["DescriptionOtherContractType"] },
    "OtherDurationType": { "min": 1, "max": 2, "facts": ["DescriptionOtherContractDurationType"] },
    "OtherChannelType": { "min": 1, "max": 2, "facts": ["DescriptionOtherSalesChannelType"] },
